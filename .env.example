# OpsPilot backend configuration (copy values into your shell or a local .env
# that is sourced by your process manager; the app does not load .env files).
#
# Local development only: explicit loopback development authentication.
OPSPILOT_AUTH_MODE=development
OPSPILOT_DEV_AUTH_ENABLED=true
OPSPILOT_HOST=127.0.0.1
OPSPILOT_CORS_ORIGINS=http://localhost:3000
# Development-only tenant identity for the synthetic dev principal. Leave
# unset to keep tenant-scoped access failing closed; never use a real tenant
# identifier from another environment here.
# OPSPILOT_DEV_TENANT_ID=dev-tenant-0001

# Storage (defaults shown). Application and workflow checkpoint databases must
# remain separate.
OPSPILOT_APP_DB=data/opspilot_app.sqlite
OPSPILOT_CHECKPOINT_DB=data/opspilot_checkpoints.sqlite

# Production token verification. Replace every placeholder through your
# deployment's secret manager; never commit real values. The JWKS URL must use
# https outside loopback.
# OPSPILOT_AUTH_MODE=production
# OPSPILOT_DEV_AUTH_ENABLED=false
# OPSPILOT_AUTH_ISSUER=https://issuer.example.com/
# OPSPILOT_AUTH_AUDIENCE=opspilot-api
# OPSPILOT_AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# OPSPILOT_AUTH_ROLES_CLAIM=roles
# OPSPILOT_AUTH_ALGORITHMS=RS256
# Verified tenant claim name. Dotted paths are supported (e.g. org.tenant_id).
# Values must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$; a token whose tenant
# claim is absent yields no tenant rather than a default.
# OPSPILOT_AUTH_TENANT_CLAIM=tenant_id

# HTTP hardening. Bodies larger than this are rejected with HTTP 413.
# OPSPILOT_MAX_REQUEST_BYTES=2097152
# Investigation start and approval are limited per authenticated principal.
# Set OPSPILOT_RATE_LIMIT_REQUESTS=0 to disable the limiter.
# OPSPILOT_RATE_LIMIT_REQUESTS=60
# OPSPILOT_RATE_LIMIT_WINDOW_SECONDS=60

# AI runtime. "disabled" keeps the API available and returns HTTP 503 for
# investigation starts. "live" requires one free-tier provider (Gemini, Groq
# or OpenRouter), an explicit free model, a server-side key, the embedding
# stack and an indexed Chroma collection; see docs/ai-runtime.md.
OPSPILOT_AI_MODE=disabled
# OPSPILOT_AI_MODE=live
# OPSPILOT_LLM_PROVIDER=gemini
# OPSPILOT_LLM_MODEL=gemini-3.5-flash   # choose a free-tier model for your account
# OPSPILOT_LLM_API_KEY=...              # or GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY
# OPSPILOT_LLM_TIMEOUT=30               # per-request bound for planner and report calls; max 120 seconds
# OPSPILOT_LLM_MAX_OUTPUT_TOKENS=1200   # max 4096
