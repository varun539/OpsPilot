# OpsPilot backend runtime configuration.
#
# Copy to `.env.production` next to compose.yaml and replace every placeholder.
# The file is read by Docker Compose as the backend service environment; the
# application itself never loads .env files. Never commit real values.
#
# Storage paths are set by compose.yaml and must not be overridden here: each
# one maps to a dedicated named volume.

# --- Authentication (production is fail-closed) -------------------------
# Startup raises and the container exits if required OIDC values are missing,
# if the JWKS URL is not https, or if development auth is enabled.
OPSPILOT_AUTH_MODE=production
OPSPILOT_DEV_AUTH_ENABLED=false
OPSPILOT_HOST=0.0.0.0
OPSPILOT_AUTH_ISSUER=https://issuer.example.com/
OPSPILOT_AUTH_AUDIENCE=opspilot-api
OPSPILOT_AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OPSPILOT_AUTH_ROLES_CLAIM=roles
# Comma-separated asymmetric algorithms. Defaults to RS/ES/PS families.
# OPSPILOT_AUTH_ALGORITHMS=RS256

# --- Browser origins ----------------------------------------------------
# Exact dashboard origins, comma separated. Never use "*" with credentials.
OPSPILOT_CORS_ORIGINS=https://app.example.com

# --- AI runtime ---------------------------------------------------------
# "disabled" keeps incident/ticket management available but returns HTTP 503
# for investigation starts. "live" assembles one explicitly selected free-tier
# LLM provider, the pinned embedding model, persistent ChromaDB, hybrid
# retrieval and RAG service at startup, and fails startup if they cannot be
# assembled.
OPSPILOT_AI_MODE=live
# gemini | groq | openrouter. OpenAI is not selectable; there is no paid
# fallback and OPENAI_API_KEY is ignored.
OPSPILOT_LLM_PROVIDER=gemini
# Required when OPSPILOT_AI_MODE=live. Use a model your account currently
# offers on a zero-cost quota. For OpenRouter the ID must end in ":free".
OPSPILOT_LLM_MODEL=replace-with-a-free-tier-model-id
# Required. Server-side only: never expose it to the frontend and never prefix
# it with NEXT_PUBLIC_. Provider-specific alternatives are GEMINI_API_KEY,
# GROQ_API_KEY and OPENROUTER_API_KEY.
OPSPILOT_LLM_API_KEY=replace-with-your-free-tier-api-key
# Bounded request settings read by backend.app.llm.config.LLMConfig.from_env.
# OPSPILOT_LLM_TIMEOUT=30
# OPSPILOT_LLM_MAX_OUTPUT_TOKENS=1200
# OPSPILOT_LLM_BASE_URL=   # https only; groq/openrouter only
#
# Before the first live investigation, index the knowledge base into the
# persistent Chroma volume (see docs/ai-runtime.md):
#   docker compose run --rm \
#     -v "$PWD/data/knowledge_base:/knowledge:ro" backend \
#     python -m backend.app.indexing --knowledge-base /knowledge

# --- Logging ------------------------------------------------------------
# The application logs to stdout/stderr. Do not route secrets into logs.
# PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------
# LOCAL CONTAINER VERIFICATION ONLY
#
# Development authentication is explicit, loopback-only and must never be
# used for a real deployment. The Compose ports are bound to 127.0.0.1, and
# OPSPILOT_HOST must stay loopback for the dev-auth guard to accept it.
# Uncomment this block only for local verification, and build the frontend
# with NEXT_PUBLIC_OPSPILOT_DEV_AUTH=true.
#
# OPSPILOT_AUTH_MODE=development
# OPSPILOT_DEV_AUTH_ENABLED=true
# OPSPILOT_HOST=127.0.0.1
# OPSPILOT_CORS_ORIGINS=http://localhost:3000
