# OpsPilot frontend configuration. NEXT_PUBLIC_* values are embedded in the
# browser bundle: never place secrets here.
NEXT_PUBLIC_OPSPILOT_API_URL=http://127.0.0.1:8000

# OIDC authorization-code + PKCE configuration. No client secret is used.
# NEXT_PUBLIC_OPSPILOT_OIDC_AUTHORITY=https://issuer.example.com/
# NEXT_PUBLIC_OPSPILOT_OIDC_CLIENT_ID=opspilot-dashboard
# NEXT_PUBLIC_OPSPILOT_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# NEXT_PUBLIC_OPSPILOT_OIDC_SCOPE=openid profile email
# NEXT_PUBLIC_OPSPILOT_ROLES_CLAIM=roles

# Local development only. Requires the backend to run with
# OPSPILOT_AUTH_MODE=development, OPSPILOT_DEV_AUTH_ENABLED=true, and a
# loopback bind address. Never enable this in a production build.
NEXT_PUBLIC_OPSPILOT_DEV_AUTH=true
