# OpsPilot frontend configuration.
#
# These NEXT_PUBLIC_* values are compiled into the browser bundle during
# `next build`. They are BUILD-TIME settings, not runtime settings: changing
# one requires rebuilding the image. Never put secrets here.
#
# For Compose, export these as shell variables before `docker compose build`
# (compose.yaml forwards them as build arguments), or use a Compose `.env`
# file in the repository root (not this directory).

# Origin the user's browser uses to reach the FastAPI backend.
# - Local containers: http://127.0.0.1:8000
# - Reverse proxy:    https://api.example.com
# Never use a Docker-internal hostname such as http://backend:8000.
NEXT_PUBLIC_OPSPILOT_API_URL=http://127.0.0.1:8000

# OIDC authorization-code + PKCE configuration. No client secret is used.
NEXT_PUBLIC_OPSPILOT_OIDC_AUTHORITY=https://issuer.example.com/
NEXT_PUBLIC_OPSPILOT_OIDC_CLIENT_ID=opspilot-dashboard
NEXT_PUBLIC_OPSPILOT_OIDC_REDIRECT_URI=https://app.example.com/auth/callback
NEXT_PUBLIC_OPSPILOT_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OPSPILOT_ROLES_CLAIM=roles

# Must remain unset/false in any image used for production. Set to true only
# for a local verification build backed by explicit development auth.
NEXT_PUBLIC_OPSPILOT_DEV_AUTH=false
